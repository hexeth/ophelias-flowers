---
import BaseLayout from "../../layouts/base-layout.astro";
import InventoryTable from "../../components/admin/inventory-table";
import { listAdminVarieties } from "../../lib/varieties";

const varieties = await listAdminVarieties(Astro.locals);
---

<BaseLayout
  title="Catalog Admin"
  description="Manage dahlia inventory, pricing, visibility, and images."
>
  <section class="px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-20">
    <div class="max-w-7xl mx-auto">
      <div class="border-b border-ink pb-8 mb-8">
        <div>
          <h1 class="mb-4">Inventory Admin</h1>
          <p class="max-w-3xl text-stone-500 leading-relaxed">
            Edit the catalog inline, keep pages hidden until they are ready, and manage uploaded imagery without leaving the inventory view.
          </p>
        </div>
      </div>

      <InventoryTable client:load initialVarieties={varieties} />
    </div>
  </section>
</BaseLayout>