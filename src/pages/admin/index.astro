---
import BaseLayout from "../../layouts/base-layout.astro";
import InventoryTable from "../../components/admin/inventory-table";
import { listAdminVarieties } from "../../lib/varieties";

const initialVarieties = await listAdminVarieties(Astro.locals);
---

<BaseLayout
  title="Catalog Admin"
  description="Manage dahlia inventory, pricing, visibility, and images."
>
  <section class="px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-20">
    <div class="max-w-7xl mx-auto">
      <div class="border-b border-ink pb-8 mb-8">
        <div>
          <h1 class="mb-4">Inventory Admin</h1>
        </div>
      </div>

      <InventoryTable
        client:load
        initialPage={1}
        initialPageSize={25}
        initialTotalCount={initialVarieties.length}
        initialVarieties={initialVarieties}
      />
    </div>
  </section>
</BaseLayout>