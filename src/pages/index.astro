---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.jpg";
import logo from "../assets/logo.png";
import BaseLayout from "../layouts/base-layout.astro";
import VarietyCard from "../components/variety-card.astro";
import { listPublicVarieties } from "../lib/varieties";

const varieties = await listPublicVarieties(Astro.locals);
const featured = varieties.slice(0, 3);
---

<BaseLayout title="Home">
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImage.src} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden">
    <div class="relative w-full" style="height: clamp(28rem, 70vh, 80vh);">
    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          format="webp"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          sizes="100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      )
    }
    <div
      class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink/90 via-ink/40 to-transparent"
    >
    </div>
    </div>
    <div
      class="absolute bottom-0 left-0 right-0 px-4 sm:px-8 lg:px-12 pb-10 sm:pb-14 lg:pb-20"
    >
      <div class="inline-block bg-cream/90 p-3 sm:p-4 mb-6">
        <Image
          src={logo}
          alt="Ophelia's Flowers logo"
          width={160}
          height={160}
          loading="eager"
          class="w-20 h-20 sm:w-28 sm:h-28 lg:w-36 lg:h-36"
        />
      </div>
      <h1
        class="font-serif text-6xl sm:text-7xl lg:text-8xl tracking-tighter text-cream mb-6"
      >
        Ophelia's Flowers
      </h1>
      <h2 class="mb-6 font-serif text-2xl tracking-tight text-cream sm:text-3xl lg:text-4xl">Dahlia tubers</h2>
      <p class="max-w-[34ch] text-lg leading-relaxed text-cream/90 sm:text-xl">
        Small-batch dahlias grown with care in the Fraser Valley. Pre-orders open for spring 2026
        planting.
      </p>
      <a
        href="/varieties"
        class="inline-block mt-8 bg-cream text-ink border border-cream px-8 py-4 text-xs uppercase tracking-widest no-underline hover:bg-transparent hover:text-cream transition-colors"
      >
        Shop All Varieties
      </a>
    </div>
  </section>

  <!-- Seasonal Message -->
  <section
    class="px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-20 border-b border-stone-300"
  >
    <div class="max-w-2xl">
      <p class="text-xs uppercase tracking-widest text-stone-500 mb-4">
        Spring 2026 Season
      </p>
      <p class="text-lg sm:text-xl leading-relaxed text-stone-500">
        Order now for spring planting.
      </p>
    </div>
  </section>

  <!-- Featured Varieties — Asymmetric Grid -->
  <section class="px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-20">
    <div class="max-w-6xl">
      <div class="mb-8 flex flex-col gap-4 border-b border-ink pb-6 sm:flex-row sm:items-end sm:justify-between lg:mb-12">
        <h2 class="max-w-[20ch]">Featured Varieties</h2>
        <p class="max-w-[52ch] text-sm leading-relaxed text-stone-500">
          A small editorial selection for the season, with one standout bloom and two companions.
        </p>
      </div>

      <div
        class="grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-3 lg:gap-8"
      >
        {
          featured[0] && (
            <div class="lg:col-span-2 lg:row-span-2">
              <VarietyCard variety={featured[0]} featured />
            </div>
          )
        }
        {
          featured[1] && (
            <div>
              <VarietyCard variety={featured[1]} />
            </div>
          )
        }
        {
          featured[2] && (
            <div>
              <VarietyCard variety={featured[2]} />
            </div>
          )
        }
      </div>

      <a
        href="/varieties"
        class="mt-8 inline-flex min-h-[44px] items-center border border-ink px-5 py-3 text-xs uppercase tracking-widest no-underline transition-colors hover:bg-ink hover:text-cream"
        >View All Varieties</a
      >
    </div>
  </section>
</BaseLayout>
