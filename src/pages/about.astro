---
import BaseLayout from "../layouts/base-layout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/hero.jpg";

const title = "About";
---

<BaseLayout title={title}>
  <div class="border-b border-ink">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <!-- Text Column -->
      <div 
        class="px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-20 lg:border-r border-ink flex flex-col justify-center min-h-[70vh]"
      >
        <h1 
          class="font-serif text-6xl sm:text-7xl lg:text-8xl tracking-tighter leading-[0.9] text-ink mb-12"
        >
          About <br/> Us.
        </h1>
        <div class="max-w-md space-y-6 text-stone-500 leading-relaxed text-lg">
          <p>
            Welcome to Ophelia’s Flowers! We’re a small, family-run dahlia farm nestled in the beautiful Fraser Valley. Our “farm” is truly a labor of love—tended entirely by our family and inspired by our 7‑year‑old daughter, Ophelia, for whom it’s named.
          </p>
          <p>
            Every tuber we grow is planted, cared for, dug, and stored by hand. It’s slow, meaningful work, and we love every part of it. From July through October, our roadside stand is filled with fresh, seasonal bouquets—hand‑tied with care and overflowing with color from our fields.
          </p>
          <p>
            We take tuber health seriously. We monitor our plants closely, sanitize our snips, and grow every tuber right here on our farm. While we follow strict sanitation procedures, we prioritize transparent information to ensure you receive healthy, robust tubers.
          </p>
          <p>
            Each hand-selected tuber will have a firm body, intact neck, and a visible eye. We are diligent with labeling, but if your plant doesn’t match our photos, please reach out. We're always happy to help!
          </p>
        </div>
      </div>
      
      <!-- Image Column -->
      <div class="relative h-[50vh] lg:h-auto overflow-hidden bg-stone-100 border-t lg:border-t-0 border-ink">
        <Image 
          src={heroImage} 
          alt="Close up of a dahlia bloom in the garden" 
          class="absolute inset-0 w-full h-full object-cover grayscale-[0.1]"
        />
      </div>
    </div>
  </div>

</BaseLayout>
