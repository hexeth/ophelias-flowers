---
import BaseLayout from "../../layouts/base-layout.astro";
import VarietiesControls from "../../components/varieties-controls.astro";
import VarietiesPageBehavior from "../../components/varieties-page-behavior.astro";
import VarietiesPagination from "../../components/varieties-pagination.astro";
import VarietyCard from "../../components/variety-card.astro";
import {
  buildVarietiesPageUrl,
  getPublicVarietyFilterData,
  getSearchResultRange,
  parsePublicVarietySearchParams,
} from "../../lib/catalog/public-variety-search";
import {
  listPublicVarieties,
  searchPublicVarieties,
} from "../../lib/varieties";

const parsedState = parsePublicVarietySearchParams(Astro.url.searchParams);
const searchParams = parsedState.searchParams;
const viewSize = parsedState.viewSize;

const [allVarieties, searchResult] = await Promise.all([
  listPublicVarieties(Astro.locals),
  searchPublicVarieties(Astro.locals, searchParams),
]);

const filterData = getPublicVarietyFilterData(allVarieties);
const range = getSearchResultRange(searchResult);
const previousPageHref =
  searchResult.page > 1
    ? buildVarietiesPageUrl(searchParams, viewSize, searchResult.page - 1)
    : null;
const nextPageHref =
  searchResult.page < searchResult.totalPages
    ? buildVarietiesPageUrl(searchParams, viewSize, searchResult.page + 1)
    : null;
---

<BaseLayout
  title="All Varieties"
  description="Browse our full collection of dahlia tubers."
>
  <section class="px-4 py-10 sm:px-8 sm:py-14 lg:px-12 lg:py-20">
    <div class="max-w-6xl">
      <h1 class="mb-3">All Varieties</h1>
      <p class="mb-6 text-stone-500 lg:mb-8">
        <span id="visible-count">{searchResult.total}</span> varieties available this
        season.
      </p>

      <VarietiesControls
        categoryOptions={filterData.categoryOptions}
        colorOptions={filterData.colorOptions}
        inStockCount={filterData.inStockCount}
      />

      {
        searchResult.total === 0 ? (
          <p
            id="no-results"
            class="py-20 text-center text-sm uppercase tracking-widest text-stone-500"
          >
            No varieties match your filters.
          </p>
        ) : (
          <>
            <div
              id="variety-grid"
              data-view-size={viewSize}
              class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8 xl:grid-cols-4"
            >
              {
                searchResult.items.map((variety) => (
                  <div class="variety-item">
                    <VarietyCard variety={variety} />
                  </div>
                ))
              }
            </div>

            <VarietiesPagination
              currentPage={searchResult.page}
              totalPages={searchResult.totalPages}
              start={range.start}
              end={range.end}
              total={searchResult.total}
              prevHref={previousPageHref}
              nextHref={nextPageHref}
            />
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<VarietiesPageBehavior />
