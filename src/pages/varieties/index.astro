---
import BaseLayout from "../../layouts/base-layout.astro";
import VarietyCard from "../../components/variety-card.astro";
import VarietiesControls from "../../components/varieties-controls.astro";
import { categoryLabels, getDisplayPrice, listPublicVarieties } from "../../lib/varieties";

const varieties = (await listPublicVarieties(Astro.locals)).sort((a, b) =>
  a.name.localeCompare(b.name, undefined, {
    numeric: true,
    sensitivity: "base",
  }),
);

/* --- Compute filter counts --- */

const categoryCounts = new Map<string, number>();
const colorCounts = new Map<string, number>();
let inStockCount = 0;

for (const v of varieties) {
  const { category, color, stock } = v;

  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);

  for (const c of color) {
    colorCounts.set(c, (colorCounts.get(c) ?? 0) + 1);
  }

  if (stock !== "sold-out") {
    inStockCount++;
  }
}

const categoryOptions = [...categoryCounts.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([value, count]) => ({
    value,
    label: categoryLabels[value as keyof typeof categoryLabels] ?? value,
    count,
  }));

const colorOptions = [...colorCounts.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([value, count]) => ({
    value,
    label: value.charAt(0).toUpperCase() + value.slice(1),
    count,
  }));
---

<BaseLayout
  title="All Varieties"
  description="Browse our full collection of dahlia tubers."
>
  <section class="px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-20">
    <div class="max-w-6xl">
      <h1 class="mb-3">All Varieties</h1>
      <p class="text-stone-500 mb-6 lg:mb-8">
        <span id="visible-count">{varieties.length}</span> varieties available this
        season.
      </p>

      <VarietiesControls
        categoryOptions={categoryOptions}
        colorOptions={colorOptions}
        inStockCount={inStockCount}
      />

      <!-- No results message -->
      <p
        id="no-results"
        class="hidden text-stone-500 text-center py-20 text-sm uppercase tracking-widest"
      >
        No varieties match your filters.
      </p>

      <!-- Product grid -->
      <div
        id="variety-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8"
      >
        {
          varieties.map((variety) => (
            <div
              data-category={variety.category}
              data-colors={variety.color.join(" ")}
              data-stock={variety.stock}
              data-name={variety.name}
              data-price={String(getDisplayPrice(variety))}
              data-search={`${variety.name} ${variety.category} ${variety.color.join(" ")} ${variety.sku}`}
              class="variety-item"
            >
              <VarietyCard variety={variety} />
            </div>
          ))
        }
      </div>

      <div
        id="pagination"
        class="mt-8 lg:mt-10 flex items-center justify-between gap-4 border-t border-ink pt-6 hidden"
      >
        <button
          type="button"
          id="page-prev"
          class="border border-ink px-4 py-3 text-xs uppercase tracking-widest transition-colors focus:ring-2 focus:ring-ink focus:outline-none disabled:border-stone-300 disabled:text-stone-300 disabled:cursor-not-allowed"
        >
          Previous
        </button>
        <p id="pagination-status" class="text-xs uppercase tracking-widest text-stone-500">
          Page 1 of 1
        </p>
        <button
          type="button"
          id="page-next"
          class="border border-ink px-4 py-3 text-xs uppercase tracking-widest transition-colors focus:ring-2 focus:ring-ink focus:outline-none disabled:border-stone-300 disabled:text-stone-300 disabled:cursor-not-allowed"
        >
          Next
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initFilters() {
    const filterGroups = document.querySelectorAll("[data-filter-group]");
    const inStockCheckbox = document.getElementById(
      "in-stock",
    ) as HTMLInputElement | null;
    const items = document.querySelectorAll(
      ".variety-item",
    ) as NodeListOf<HTMLElement>;
    const visibleCount = document.getElementById("visible-count");
    const noResults = document.getElementById("no-results");
    const grid = document.getElementById("variety-grid");
    const resultsPerPageSelect = document.getElementById(
      "results-per-page",
    ) as HTMLSelectElement | null;
    const sortBySelect = document.getElementById(
      "sort-by",
    ) as HTMLSelectElement | null;
    const viewSizeSelect = document.getElementById(
      "view-size",
    ) as HTMLSelectElement | null;
    const pagination = document.getElementById("pagination");
    const prevButton = document.getElementById(
      "page-prev",
    ) as HTMLButtonElement | null;
    const nextButton = document.getElementById(
      "page-next",
    ) as HTMLButtonElement | null;
    const paginationStatus = document.getElementById("pagination-status");
    const navSearchDesktop = document.getElementById(
      "nav-search-desktop",
    ) as HTMLInputElement | null;
    const navSearchMobile = document.getElementById(
      "nav-search-mobile",
    ) as HTMLInputElement | null;
    const initialSearchValue = "";
    let searchQuery = initialSearchValue.toLowerCase();
    const searchInputs = [navSearchDesktop, navSearchMobile].filter(
      (input): input is HTMLInputElement => input !== null,
    );

    const gridViewClasses = [
      "grid-cols-1",
      "grid-cols-2",
      "sm:grid-cols-2",
      "sm:grid-cols-3",
      "lg:grid-cols-3",
      "lg:grid-cols-4",
    ];

    const viewSizeClassMap: Record<string, string[]> = {
      comfortable: ["grid-cols-1", "sm:grid-cols-2", "lg:grid-cols-3"],
      compact: ["grid-cols-2", "sm:grid-cols-3", "lg:grid-cols-4"],
    };

    const defaultResultsPerPage = 24;
    let currentPage = 1;
    let resultsPerPage = defaultResultsPerPage;

    if (
      !inStockCheckbox ||
      !grid ||
      !resultsPerPageSelect ||
      !sortBySelect ||
      !viewSizeSelect ||
      !pagination ||
      !prevButton ||
      !nextButton ||
      !paginationStatus
    ) {
      return;
    }

    if (grid.dataset.initialized === "true") return;
    grid.dataset.initialized = "true";

    searchInputs.forEach((input) => {
      input.value = initialSearchValue;
    });

    const gridEl = grid;
    const paginationEl = pagination;
    const prevPageButton = prevButton;
    const nextPageButton = nextButton;
    const paginationStatusEl = paginationStatus;
    const listSectionEl = gridEl.closest("section") as HTMLElement | null;
    const inStockCheckboxEl = inStockCheckbox;
    const viewSizeSelectEl = viewSizeSelect;
    const resultsPerPageSelectEl = resultsPerPageSelect;
    const sortSelectEl = sortBySelect;
    const defaultSortBy = "name-asc";
    const defaultViewSize = "comfortable";

    interface UrlFilterState {
      selectedCategories: string[];
      selectedColors: string[];
      inStockOnly: boolean;
      sortBy: string;
      viewSize: string;
      resultsPerPage: number;
      currentPage: number;
      searchQuery: string;
    }

    resultsPerPageSelectEl.value = String(defaultResultsPerPage);
    resultsPerPage = Number.parseInt(resultsPerPageSelectEl.value, 10);

    function setSelectIfValid(selectEl: HTMLSelectElement, value: string | undefined) {
      if (!value) return;
      const hasOption = Array.from(selectEl.options).some(
        (option) => option.value === value,
      );
      if (hasOption) {
        selectEl.value = value;
      }
    }

    function setSelected(groupId: string, values: string[]) {
      const group = document.querySelector(`[data-filter-group="${groupId}"]`);
      if (!group) return;

      const valueSet = new Set(values);
      const checkboxes = group.querySelectorAll(
        'input[type="checkbox"]',
      ) as NodeListOf<HTMLInputElement>;

      checkboxes.forEach((checkbox) => {
        checkbox.checked = valueSet.has(checkbox.value);
      });
    }

    function parsePositiveInt(value: string | null, fallback: number): number {
      const parsed = Number.parseInt(value ?? "", 10);
      return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
    }

    function readFilterStateFromUrl(): UrlFilterState {
      const searchParams = new URLSearchParams(window.location.search);

      return {
        selectedCategories: Array.from(
          new Set(searchParams.getAll("category").filter((value) => value.length > 0)),
        ),
        selectedColors: Array.from(
          new Set(searchParams.getAll("color").filter((value) => value.length > 0)),
        ),
        inStockOnly: searchParams.get("stock") === "in",
        sortBy: searchParams.get("sort") ?? defaultSortBy,
        viewSize: searchParams.get("view") ?? defaultViewSize,
        resultsPerPage: parsePositiveInt(
          searchParams.get("perPage"),
          defaultResultsPerPage,
        ),
        currentPage: parsePositiveInt(searchParams.get("page"), 1),
        searchQuery: (searchParams.get("q") ?? "").trim(),
      };
    }

    function applyStateToControls(state: UrlFilterState) {
      setSelected("category", state.selectedCategories);
      setSelected("color", state.selectedColors);
      inStockCheckboxEl.checked = state.inStockOnly;
      setSelectIfValid(sortSelectEl, state.sortBy);
      setSelectIfValid(viewSizeSelectEl, state.viewSize);
      setSelectIfValid(resultsPerPageSelectEl, String(state.resultsPerPage));
      resultsPerPage = Number.parseInt(resultsPerPageSelectEl.value, 10);
      currentPage = state.currentPage;
      searchQuery = state.searchQuery.toLowerCase();
      searchInputs.forEach((input) => {
        input.value = state.searchQuery;
      });
    }

    function syncUrlWithCurrentState() {
      const searchParams = new URLSearchParams(window.location.search);

      ["category", "color", "stock", "sort", "view", "perPage", "page", "q"].forEach(
        (key) => {
          searchParams.delete(key);
        },
      );

      const selectedCategories = getSelected("category");
      const selectedColors = getSelected("color");

      selectedCategories.forEach((category) => {
        searchParams.append("category", category);
      });

      selectedColors.forEach((color) => {
        searchParams.append("color", color);
      });

      if (inStockCheckboxEl.checked) {
        searchParams.set("stock", "in");
      }

      if (sortSelectEl.value !== defaultSortBy) {
        searchParams.set("sort", sortSelectEl.value);
      }

      if (viewSizeSelectEl.value !== defaultViewSize) {
        searchParams.set("view", viewSizeSelectEl.value);
      }

      if (resultsPerPage !== defaultResultsPerPage) {
        searchParams.set("perPage", String(resultsPerPage));
      }

      if (currentPage > 1) {
        searchParams.set("page", String(currentPage));
      }

      const query = searchQuery.trim();
      if (query.length > 0) {
        searchParams.set("q", query);
      }

      const nextQueryString = searchParams.toString();
      const nextUrl = `${window.location.pathname}${nextQueryString ? `?${nextQueryString}` : ""}${window.location.hash}`;
      const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;

      if (nextUrl !== currentUrl) {
        window.history.replaceState(null, "", nextUrl);
      }
    }

    function sortItems(itemsToSort: HTMLElement[]): HTMLElement[] {
      const sortBy = sortSelectEl.value;
      const collator = new Intl.Collator(undefined, {
        numeric: true,
        sensitivity: "base",
      });

      return itemsToSort.sort((a, b) => {
        const aName = a.dataset.name ?? "";
        const bName = b.dataset.name ?? "";
        const aPrice = Number.parseFloat(a.dataset.price ?? "0");
        const bPrice = Number.parseFloat(b.dataset.price ?? "0");
        const comparison = collator.compare(aName, bName);

        if (sortBy === "price-asc") {
          return aPrice === bPrice ? comparison : aPrice - bPrice;
        }

        if (sortBy === "price-desc") {
          return aPrice === bPrice ? comparison : bPrice - aPrice;
        }

        if (sortBy === "name-desc") {
          return -comparison;
        }

        return comparison;
      });
    }

    function setViewSize(viewSize: string) {
      gridEl.classList.remove(...gridViewClasses);
      const classes = viewSizeClassMap[viewSize] ?? viewSizeClassMap.comfortable;
      gridEl.classList.add(...classes);
    }

    function getSelected(groupId: string): string[] {
      const group = document.querySelector(`[data-filter-group="${groupId}"]`);
      if (!group) return [];
      const checked = group.querySelectorAll(
        'input[type="checkbox"]:checked',
      ) as NodeListOf<HTMLInputElement>;
      return Array.from(checked).map((cb) => cb.value);
    }

    function updateSummary(groupId: string, allLabel: string) {
      const group = document.querySelector(`[data-filter-group="${groupId}"]`);
      if (!group) return;
      const summary = group.querySelector(".filter-summary-text");
      if (!summary) return;
      const selected = getSelected(groupId);
      if (selected.length === 0) {
        summary.textContent = allLabel;
      } else if (selected.length === 1) {
        const label = group
          .querySelector(`input[value="${selected[0]}"]`)
          ?.closest("label");
        const text =
          label?.querySelector(".truncate")?.textContent ?? selected[0];
        summary.textContent = text.trim();
      } else {
        summary.textContent = `${selected.length} selected`;
      }
    }

    function applyFilters() {
      const selectedCategories = getSelected("category");
      const selectedColors = getSelected("color");
      const inStockOnly = inStockCheckbox!.checked;
      const filteredItems: HTMLElement[] = [];

      items.forEach((item) => {
        const itemCategory = item.dataset.category ?? "";
        const itemColors = (item.dataset.colors ?? "").split(" ");
        const itemStock = item.dataset.stock ?? "";
        const itemSearch = (item.dataset.search ?? "").toLowerCase();

        const matchesCategory =
          selectedCategories.length === 0 ||
          selectedCategories.includes(itemCategory);
        const matchesColor =
          selectedColors.length === 0 ||
          selectedColors.some((c) => itemColors.includes(c));
        const matchesStock = !inStockOnly || itemStock !== "sold-out";
        const matchesSearch = searchQuery.length === 0 || itemSearch.includes(searchQuery);

        if (matchesCategory && matchesColor && matchesStock && matchesSearch) {
          filteredItems.push(item);
        }

        item.style.display = "none";
      });

      const count = filteredItems.length;
      const sortedItems = sortItems(filteredItems);
      const totalPages = Math.max(1, Math.ceil(count / resultsPerPage));

      if (currentPage > totalPages) {
        currentPage = totalPages;
      }

      const start = (currentPage - 1) * resultsPerPage;
      const end = start + resultsPerPage;
      const pageItems = sortedItems.slice(start, end);

      sortedItems.forEach((item) => {
        gridEl.appendChild(item);
      });

      pageItems.forEach((item) => {
        item.style.display = "";
      });

      updateSummary("category", "All Categories");
      updateSummary("color", "All Colors");

      if (visibleCount) visibleCount.textContent = String(count);
      if (noResults) {
        noResults.classList.toggle("hidden", count > 0);
      }

      gridEl.classList.toggle("hidden", count === 0);

      if (count === 0) {
        paginationStatusEl.textContent = "Page 0 of 0";
      } else {
        const rangeStart = start + 1;
        const rangeEnd = Math.min(end, count);
        paginationStatusEl.textContent = `Page ${currentPage} of ${totalPages} · ${rangeStart}-${rangeEnd} of ${count}`;
      }

      prevPageButton.disabled = count === 0 || currentPage <= 1;
      nextPageButton.disabled = count === 0 || currentPage >= totalPages;
      paginationEl.classList.toggle("hidden", count <= resultsPerPage);
      syncUrlWithCurrentState();
    }

    function scrollToListTop() {
      const topTarget = listSectionEl ?? gridEl;
      const top = Math.max(
        0,
        topTarget.getBoundingClientRect().top + window.scrollY,
      );
      window.scrollTo({ top, behavior: "auto" });
    }

    // Listen to checkbox changes inside filter groups
    filterGroups.forEach((group) => {
      group.addEventListener("change", () => {
        currentPage = 1;
        applyFilters();
      });
    });

    // Listen to in-stock checkbox
    inStockCheckbox.addEventListener("change", () => {
      currentPage = 1;
      applyFilters();
    });

    resultsPerPageSelect.addEventListener("change", () => {
      const parsed = Number.parseInt(resultsPerPageSelect.value, 10);
      resultsPerPage = Number.isFinite(parsed) && parsed > 0 ? parsed : 24;
      currentPage = 1;
      applyFilters();
    });

    sortSelectEl.addEventListener("change", () => {
      currentPage = 1;
      applyFilters();
    });

    viewSizeSelect.addEventListener("change", () => {
      setViewSize(viewSizeSelect.value);
      applyFilters();
    });

    prevPageButton.addEventListener("click", () => {
      if (currentPage <= 1) return;
      currentPage -= 1;
      applyFilters();
      scrollToListTop();
    });

    nextPageButton.addEventListener("click", () => {
      currentPage += 1;
      applyFilters();
      scrollToListTop();
    });

    // Close other dropdowns when one opens
    filterGroups.forEach((group) => {
      group.addEventListener("toggle", () => {
        if ((group as HTMLDetailsElement).open) {
          filterGroups.forEach((other) => {
            if (other !== group) {
              (other as HTMLDetailsElement).open = false;
            }
          });
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest("[data-filter-group]")) {
        filterGroups.forEach((group) => {
          (group as HTMLDetailsElement).open = false;
        });
      }
    });

    const initialState = readFilterStateFromUrl();
    applyStateToControls(initialState);

    setViewSize(viewSizeSelect.value);
    applyFilters();

    window.addEventListener("popstate", () => {
      const stateFromUrl = readFilterStateFromUrl();
      applyStateToControls(stateFromUrl);
      setViewSize(viewSizeSelect.value);
      applyFilters();
    });
  }

  // Astro module scripts are deferred — DOM is ready
  initFilters();
  // Also re-init if View Transitions are used
  document.addEventListener("astro:after-swap", initFilters);
</script>
