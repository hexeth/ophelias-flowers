---
interface FilterOption {
  value: string;
  label: string;
  count: number;
}

interface Props {
  id: string;
  label: string;
  options: FilterOption[];
  allLabel?: string;
}

const { id, label, options, allLabel = "All" } = Astro.props;
---

<details class="filter-dropdown relative" data-filter-group={id}>
  <summary
    class="list-none flex min-h-[44px] items-center justify-between gap-2 border border-ink bg-white px-4 py-3 text-xs uppercase tracking-widest text-ink cursor-pointer select-none w-full focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
    aria-label={`Filter by ${label}`}
  >
    <span class="filter-summary-text truncate">{allLabel}</span>
    <svg
      class="shrink-0 w-4 h-4 text-ink transition-transform filter-chevron"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="square" d="M6 9l6 6 6-6"></path>
    </svg>
  </summary>
  <div class="absolute z-20 left-0 top-full mt-px w-full min-w-0 border border-ink border-t-0 bg-white sm:min-w-[12rem]">
    <div class="max-h-64 overflow-y-auto">
      {
          options.map((opt) => (
          <label class="flex min-h-[44px] items-center gap-3 px-4 py-2.5 text-xs uppercase tracking-widest cursor-pointer transition-colors hover:bg-cream focus-within:bg-cream">
            <input
              type="checkbox"
              name={id}
              value={opt.value}
              class="h-4 w-4 shrink-0 cursor-pointer accent-ink"
            />
            <span class="truncate">{opt.label}</span>
            <span class="ml-auto text-stone-500 tabular-nums">{opt.count}</span>
          </label>
        ))
      }
    </div>
    <button
      type="button"
      class="lg:hidden min-h-[44px] w-full border-t border-ink px-4 py-3 text-center text-xs uppercase tracking-widest text-ink transition-colors hover:bg-ink hover:text-cream focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
      data-filter-ok
    >
      Ok
    </button>
  </div>
</details>

<script>
  function initFilterDropdowns() {
    const dropdowns = document.querySelectorAll("details.filter-dropdown") as NodeListOf<HTMLDetailsElement>;

    dropdowns.forEach((dropdown) => {
      if (dropdown.dataset.initialized === "true") return;

      const okButton = dropdown.querySelector("[data-filter-ok]") as HTMLButtonElement | null;

      dropdown.addEventListener("change", () => {
        dropdown.dataset.dirty = "true";
      });

      dropdown.addEventListener("toggle", () => {
        if (!dropdown.open && dropdown.dataset.dirty === "true") {
          const groupId = dropdown.dataset.filterGroup ?? "";
          dropdown.dispatchEvent(
            new CustomEvent("filter-dropdown-confirmed", {
              bubbles: true,
              detail: { groupId },
            }),
          );
          dropdown.dataset.dirty = "false";
        }
      });

      okButton?.addEventListener("click", () => {
        dropdown.open = false;
      });

      dropdown.dataset.initialized = "true";
    });

    if (document.body.dataset.filterDropdownDismissReady === "true") {
      return;
    }

    document.addEventListener("pointerdown", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("details.filter-dropdown")) {
        return;
      }

      const openDropdowns = document.querySelectorAll(
        "details.filter-dropdown[open]",
      ) as NodeListOf<HTMLDetailsElement>;

      openDropdowns.forEach((dropdown) => {
        dropdown.open = false;
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;

      const openDropdowns = document.querySelectorAll(
        "details.filter-dropdown[open]",
      ) as NodeListOf<HTMLDetailsElement>;

      openDropdowns.forEach((dropdown) => {
        dropdown.open = false;
      });
    });

    document.body.dataset.filterDropdownDismissReady = "true";
  }

  initFilterDropdowns();
  document.addEventListener("astro:after-swap", initFilterDropdowns);
</script>

<style>
  details[open] .filter-chevron {
    transform: rotate(180deg);
  }
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
