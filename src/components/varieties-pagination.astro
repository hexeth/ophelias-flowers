---
interface Props {
  currentPage: number;
  end: number;
  nextHref: string | null;
  prevHref: string | null;
  start: number;
  total: number;
  totalPages: number;
}

const { currentPage, end, nextHref, prevHref, start, total, totalPages } =
  Astro.props;
---

<div
  id="pagination"
  class="mt-8 lg:mt-10 flex items-center justify-between gap-4 border-t border-ink pt-6"
>
  {
    prevHref ? (
      <a
        href={prevHref}
        class="border border-ink px-4 py-3 text-xs uppercase tracking-widest no-underline transition-colors focus:ring-2 focus:ring-ink focus:outline-none hover:bg-ink hover:text-cream"
      >
        Previous
      </a>
    ) : (
      <span class="border border-stone-300 px-4 py-3 text-xs uppercase tracking-widest text-stone-300">
        Previous
      </span>
    )
  }

  <p id="pagination-status" class="text-xs uppercase tracking-widest text-stone-500">
    Page {currentPage} of {totalPages} · {start}-{end} of {total}
  </p>

  {
    nextHref ? (
      <a
        href={nextHref}
        class="border border-ink px-4 py-3 text-xs uppercase tracking-widest no-underline transition-colors focus:ring-2 focus:ring-ink focus:outline-none hover:bg-ink hover:text-cream"
      >
        Next
      </a>
    ) : (
      <span class="border border-stone-300 px-4 py-3 text-xs uppercase tracking-widest text-stone-300">
        Next
      </span>
    )
  }
</div>