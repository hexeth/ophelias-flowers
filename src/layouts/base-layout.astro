---
import { ClientRouter, fade } from "astro:transitions";
import Breadcrumbs from "../components/breadcrumbs.astro";
import SiteSearchAutocomplete from "../components/site-search-autocomplete.astro";
import SiteSearchForm from "../components/site-search-form.astro";
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/700.css";
import playfairLatin400 from "@fontsource/playfair-display/files/playfair-display-latin-400-normal.woff2?url";
import playfairLatin700 from "@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Ophelia's Flowers — Dahlia tubers for the passionate gardener.",
} = Astro.props;
const isVarietiesTransitionRoute =
  Astro.url.pathname === "/varieties" || Astro.url.pathname.startsWith("/varieties/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={playfairLatin400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={playfairLatin700} />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Ophelia's Flowers</title>
    <ClientRouter />
  </head>
  <body>
    <slot name="header">
      <header
        class="border-b border-ink px-4 sm:px-8 lg:px-12 py-6"
      >
        <div class="flex items-center justify-between">
          <a href="/" class="no-underline">
            <span class="font-serif text-2xl lg:text-3xl tracking-tight">
              Ophelia's Flowers
            </span>
          </a>

          <div class="sm:hidden flex items-center gap-2">
            <button
              id="mobile-search-toggle"
              type="button"
              class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center border border-ink p-2 transition-colors hover:bg-ink hover:text-white focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
              aria-expanded="false"
              aria-controls="mobile-search-panel"
              aria-label="Open search"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke-width="2" />
                <path stroke-linecap="square" stroke-width="2" d="M20 20l-3.5-3.5" />
              </svg>
            </button>

            <!-- Mobile menu button -->
            <button
              id="mobile-menu-toggle"
              type="button"
              class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center border border-ink p-2 transition-colors hover:bg-ink hover:text-white focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
              aria-expanded="false"
              aria-controls="main-nav"
              aria-label="Open menu"
            >
              <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" stroke-width="2" d="M6 6l12 12M6 18L18 6" />
              </svg>
            </button>
          </div>

          <!-- Desktop nav -->
          <div class="hidden sm:flex items-center gap-6">
            <SiteSearchForm
              inputClassName="border border-ink bg-white px-4 py-2 text-sm w-52 lg:w-64 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
              inputId="nav-search-desktop"
              layoutClassName="flex items-center gap-2"
              inputWrapperClassName="relative"
              panelId="nav-search-desktop-suggestions"
              submitButtonClassName="border border-ink bg-ink text-white px-3 py-2 text-xs uppercase tracking-widest transition-colors hover:bg-white hover:text-ink focus:ring-2 focus:ring-ink focus:ring-offset-2 focus:outline-none"
            />

            <nav aria-label="Main navigation">
              <ul class="flex gap-6 text-xs uppercase tracking-widest items-center">
                <li>
                  <a
                    href="/varieties"
                    class="inline-flex min-h-[44px] items-center no-underline transition-colors hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                    >Shop</a
                  >
                </li>
                <li>
                  <a
                    href="/about"
                    class="inline-flex min-h-[44px] items-center no-underline transition-colors hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                    >About</a
                  >
                </li>
                <li>
                  <a
                    href="/cart"
                    class="inline-flex min-h-[44px] items-center gap-2 no-underline transition-colors hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                  >
                    <span>Cart</span>
                    <span
                      id="cart-count"
                      class="text-xs"
                      hidden>(0)</span
                    >
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>

        <div
          id="mobile-search-panel"
          class="hidden sm:hidden border-t border-stone-300 mt-6 pt-6"
        >
          <SiteSearchForm
            inputClassName="min-h-12 w-full border border-ink bg-white px-4 py-3 text-base focus:ring-2 focus:ring-ink focus:outline-none"
            inputId="nav-search-mobile"
            layoutClassName="flex flex-col items-stretch gap-3"
            inputWrapperClassName="relative flex-1"
            panelClassName="max-h-[min(22rem,calc(100vh-12rem))]"
            panelId="nav-search-mobile-suggestions"
            submitButtonClassName="min-h-12 w-full border border-ink bg-ink px-4 py-3 text-xs uppercase tracking-widest text-white transition-colors hover:bg-white hover:text-ink focus:ring-2 focus:ring-ink focus:ring-offset-2 focus:outline-none"
          />
        </div>

        <!-- Mobile nav -->
        <nav
          id="main-nav"
          class="hidden sm:hidden border-t border-stone-300 mt-6 pt-6"
          aria-label="Main navigation"
        >
          <ul class="flex flex-col gap-4 text-xs uppercase tracking-widest">
            <li>
              <a
                href="/varieties"
                class="inline-flex min-h-[44px] items-center no-underline transition-colors hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                >Shop</a
              >
            </li>
            <li>
              <a
                href="/about"
                class="inline-flex min-h-[44px] items-center no-underline transition-colors hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                >About</a
              >
            </li>
            <li>
              <a
                href="/cart"
                class="inline-flex min-h-[44px] items-center gap-2 no-underline transition-colors hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
              >
                <span>Cart</span>
                <span
                  id="cart-count-mobile"
                  class="text-xs"
                  hidden>(0)</span
                >
              </a>
            </li>
          </ul>
        </nav>
      </header>
    </slot>

    <Breadcrumbs />

    {
      isVarietiesTransitionRoute ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="flex-1" transition:animate={fade({ duration: "0.2s" })}>
          <slot />
        </main>
      )
    }

    <footer
      class="border-t border-ink px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-16 mt-auto"
    >
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl"
      >
        <div>
          <p class="font-serif text-lg mb-3">Ophelia's Flowers</p>
          <p class="text-sm text-stone-500 leading-relaxed">
            Small-batch dahlia tubers grown with care for the passionate
            gardener.
          </p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest font-semibold mb-3">
            Quick Links
          </p>
          <ul class="space-y-1 text-sm text-stone-500">
            <li>
              <a
                href="/varieties"
                class="inline-flex min-h-[40px] items-center no-underline transition-colors hover:text-ink focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                >Shop All Varieties</a
              >
            </li>
            <li>
              <a
                href="/about"
                class="inline-flex min-h-[40px] items-center no-underline transition-colors hover:text-ink focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                >About Us</a
              >
            </li>
            <li>
              <a
                href="/cart"
                class="inline-flex min-h-[40px] items-center no-underline transition-colors hover:text-ink focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2">Cart</a
              >
            </li>
          </ul>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest font-semibold mb-3">
            Get in Touch
          </p>
          <ul class="space-y-2 text-sm text-stone-500">
            <li>
              <a
                href="mailto:hello@opheliasflowers.ca"
                class="inline-flex min-h-[40px] items-center no-underline transition-colors hover:text-ink focus:outline-none focus:ring-2 focus:ring-ink focus:ring-offset-2"
                >hello@opheliasflowers.ca</a
              >
            </li>
            <li>Chilliwack, BC Canada</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-stone-300 mt-10 pt-6 text-xs text-stone-500">
        <p>
          &copy; {new Date().getFullYear()} Ophelia's Flowers. All rights reserved.
        </p>
      </div>
    </footer>

    <script>
      import { loadCart, getCartItemCount } from "../lib/commerce/cart";

      let mobileControlsBound = false;

      function updateCartCount() {
        const cartCount = document.getElementById("cart-count");
        const cartCountMobile = document.getElementById("cart-count-mobile");
        const cart = loadCart();
        const count = getCartItemCount(cart);
        [cartCount, cartCountMobile].forEach((el) => {
          if (el) {
            el.textContent = `(${count})`;
            el.hidden = count === 0;
          }
        });
      }

      function closeMobilePanels() {
        const toggle = document.getElementById("mobile-menu-toggle");
        const mobileNav = document.getElementById("main-nav");
        const iconOpen = document.getElementById("menu-icon-open");
        const iconClose = document.getElementById("menu-icon-close");
        const searchToggle = document.getElementById("mobile-search-toggle");
        const mobileSearchPanel = document.getElementById("mobile-search-panel");

        if (toggle && mobileNav && iconOpen && iconClose) {
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Open menu");
          mobileNav.classList.add("hidden");
          iconOpen.classList.remove("hidden");
          iconClose.classList.add("hidden");
        }

        if (searchToggle && mobileSearchPanel) {
          searchToggle.setAttribute("aria-expanded", "false");
          searchToggle.setAttribute("aria-label", "Open search");
          mobileSearchPanel.classList.add("hidden");
        }
      }

      function initMobileControls() {
        if (mobileControlsBound) {
          return;
        }
        mobileControlsBound = true;

        // Delegate clicks so controls keep working after Astro swaps DOM nodes.
        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) {
            return;
          }

          const menuToggle = target.closest("#mobile-menu-toggle");
          if (menuToggle instanceof HTMLButtonElement) {
            const mobileNav = document.getElementById("main-nav");
            const iconOpen = document.getElementById("menu-icon-open");
            const iconClose = document.getElementById("menu-icon-close");
            if (mobileNav && iconOpen && iconClose) {
              const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
              menuToggle.setAttribute("aria-expanded", String(!isOpen));
              menuToggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
              mobileNav.classList.toggle("hidden");
              iconOpen.classList.toggle("hidden");
              iconClose.classList.toggle("hidden");
            }
            return;
          }

          const searchToggle = target.closest("#mobile-search-toggle");
          if (searchToggle instanceof HTMLButtonElement) {
            const mobileSearchPanel = document.getElementById("mobile-search-panel");
            const mobileSearchInput = document.getElementById(
              "nav-search-mobile",
            ) as HTMLInputElement | null;
            if (mobileSearchPanel) {
              const isOpen = searchToggle.getAttribute("aria-expanded") === "true";
              searchToggle.setAttribute("aria-expanded", String(!isOpen));
              searchToggle.setAttribute("aria-label", isOpen ? "Open search" : "Close search");
              mobileSearchPanel.classList.toggle("hidden");

              if (!isOpen && mobileSearchInput) {
                mobileSearchInput.focus();
              }
            }
          }
        });
      }

      function initLayoutBehaviors() {
        updateCartCount();
        initMobileControls();
      }

      // Initialize on initial load and every Astro page navigation.
      document.addEventListener("astro:page-load", initLayoutBehaviors);

      // Close mobile menu and search panel before each SPA navigation.
      document.addEventListener("astro:before-swap", closeMobilePanels);
    </script>

    <SiteSearchAutocomplete />
  </body>
</html>
